{
  "name": "timbrature",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icone": "node scripts/genera-icone.mjs",
    "versione:controlla": "node --experimental-strip-types scripts/rilascio.ts controlla",
    "versione:codice": "node --experimental-strip-types scripts/rilascio.ts codice",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "android:apri": "npm run build:android && cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1"
  }
}
